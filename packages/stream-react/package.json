{
  "name": "@agenticgraph/stream-react",
  "version": "0.1.2",
  "description": "React hooks and selectors for AgenticGraph streaming",
  "keywords": [
    "agenticgraph",
    "laravel",
    "streaming",
    "sse",
    "react",
    "hooks",
    "ai",
    "llm"
  ],
  "homepage": "https://agenticgraph.dev/docs/stream-getting-started",
  "bugs": {
    "url": "https://github.com/shahzad-io/agenticgraph-stream-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahzad-io/agenticgraph-stream-client.git",
    "directory": "packages/stream-react"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agenticgraph/stream-client": "^0.1.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
