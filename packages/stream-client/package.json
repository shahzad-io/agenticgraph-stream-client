{
  "name": "@agenticgraph/stream-client",
  "version": "0.1.2",
  "description": "Framework-agnostic streaming SDK for AgenticGraph wire events",
  "keywords": [
    "agenticgraph",
    "laravel",
    "streaming",
    "sse",
    "server-sent-events",
    "laravel-echo",
    "ai",
    "llm"
  ],
  "homepage": "https://agenticgraph.dev/docs/stream-getting-started",
  "bugs": {
    "url": "https://github.com/shahzad-io/agenticgraph-stream-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahzad-io/agenticgraph-stream-client.git",
    "directory": "packages/stream-client"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./iife": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "laravel-echo": ">=1.16.0"
  },
  "peerDependenciesMeta": {
    "laravel-echo": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "./dist/index.global.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
