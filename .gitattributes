# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html
# npm publishes each package's dist/ only ("files" in package.json). These rules shape the
# git archive (a GitHub tarball), which keeps src and the build config so it can be built.

/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/scripts export-ignore
*.test.ts export-ignore
*.test.tsx export-ignore
/packages/*/vitest.config.ts export-ignore
/packages/*/tsconfig.test.json export-ignore
/packages/stream-client/src/testing export-ignore
/packages/stream-client/src/types/__type-tests__ export-ignore
.DS_Store export-ignore
